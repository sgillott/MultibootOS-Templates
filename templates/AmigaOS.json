{
  // AmigaOS: one entry per version, newest first (PLAN.md 22.5, R3).
  "versions": [
    {
      // AmigaOS 3.2, installed on the PC from the user's own ADF files and update archive (media.json lists the disks and update levels;
      // templates/amigaos-<level>.json says what goes where). ADH1 is a fresh partition: the core's ADH1 folder (the framework) is copied
      // first by the builder, then the staged AmigaOS files, then the files generated for the menu.
      "id": "amigaos-3.2",
      "label": "AmigaOS 3.2",
      "script": "AmigaOS32",
      "flag": "amigaos",
      "bootDevice": "ADH1",
      "install": "media.json",
      "partitions": [
        { "device": "ADH1", "volume": "AmigaOS", "dosType": "PDS3", "minBytes": 200000000, "bootable": true, "bootPriority": 0 }
      ],

      // Read by the Image Builder application only (MultibootOS.Core ignores "gui").
      // distributedBytes is ADH1 in the MultibootOS 2.3 image; shrinkMinBytes is the plan's 200 MB floor (a 3.2.3 install measures about 45 MB with the framework).
      "gui": {
        "family": "amigaos",
        "name": "AmigaOS 3.2",
        "description": "The official Workbench 3.2, installed from your own disks.",
        "intro": "AmigaOS 3.2 is a commercial product. MultibootOS installs it from the Kickstart ROM and the disks, ADF files or archives that you own.",
        "color": "#2F6DB5", "darkColor": "#5B9BE0",
        "version": "3.2", "revision": 1, "order": 10,
        "author": "Hyperion Entertainment",
        "licence": "Commercial product. You must supply your own licensed files.",
        "licenceRequirement": "userSupplied",
        "infoUrl": "https://www.hyperion-entertainment.com",
        "downloadUrl": null,
        "downloadSize": null,
        "obtained": "userSupplied",
        "defaultSelected": true,
        "messages": [],
        "sources": [
          { "label": "Folder with the AmigaOS 3.2 ADF files", "watermark": "Folder with your original 3.2 ADF files", "recognisedAs": "11 original 3.2 ADF files", "kind": "folder" },
          { "label": "Update archive", "watermark": "Your 3.2 update archive, for example AmigaOS3.2.3.lha", "recognisedAs": "", "kind": "file" }
        ],
        "addPartitionAllowed": true,
        "partitions": [
          { "device": "ADH1", "volume": "AmigaOS", "distributedBytes": 1154908160, "shrinkMinBytes": 200000000, "shrinkOrder": 3, "dosType": "PDS\\3", "bootable": true }
        ]
      }
    }
  ]
}
