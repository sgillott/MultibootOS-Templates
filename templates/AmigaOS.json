{
  // AmigaOS 3.2 by Hyperion Entertainment.
  // Sizes are in GB. A partition taken from the source ("from") gets its exact size from the image at build time.
  // What is the same for every version is at the top; "versions" lists each release, newest first (PLAN.md 22.5, R3).
  "name": "AmigaOS 3.2",
  "author": "Hyperion Entertainment",
  "description": "The official Workbench 3.2, installed from your own disks.",
  "intro": "AmigaOS 3.2 is a commercial product. MultibootOS installs it from the Kickstart ROM and the disks, ADF files or archives that you own.",
  "website": "https://www.hyperion-entertainment.com",
  "licence": "Commercial product. You must supply your own licensed files.",
  "licenceRequirement": "userSupplied",
  "order": 10,
  "colours": {"light": "#2F6DB5", "dark": "#5B9BE0"},
  "selectedByDefault": true,
  "addPartitionAllowed": true,
  "bootMenu": {"label": "AmigaOS 3.2", "script": "AmigaOS32", "flag": "amigaos", "startsFrom": "ADH1"},
  "versions": [
    // AmigaOS 3.2, installed on the PC from the user's own ADF files and update archive (media.json lists the disks and update levels;
    // templates/amigaos-<level>.json says what goes where). ADH1 is a fresh partition: the core's ADH1 folder (the framework) is copied
    // first by the builder, then the staged AmigaOS files, then the files generated for the menu.
    // size is ADH1 in the MultibootOS 2.3 image; smallest is the plan's 200 MB floor (a 3.2.3 install measures about 45 MB with the framework).
    {
      "id": "amigaos-3.2",
      "version": "3.2",
      "install": "media.json",
      "sources": [
        {
          "label": "Folder with the AmigaOS 3.2 ADF files",
          "hint": "Folder with your original 3.2 ADF files",
          "recognisedAs": "11 original 3.2 ADF files",
          "kind": "folder"
        },
        {"label": "Update archive", "hint": "Your 3.2 update archive, for example AmigaOS3.2.3.lha", "kind": "file"}
      ],
      "partitions": [
        {"device": "ADH1", "volume": "AmigaOS", "dosType": "PDS3", "size": 1.15, "smallest": 0.2, "shrinkOrder": 3, "bootable": true}
      ]
    }
  ]
}
