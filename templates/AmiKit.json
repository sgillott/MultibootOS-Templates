{
  // AmiKit by Ján Zahurančík and contributors.
  // Sizes are in GB. A partition taken from the source ("from") gets its exact size from the image at build time.
  // What is the same for every version is at the top; "versions" lists each release, newest first (PLAN.md 22.5, R3).
  "name": "AmiKit",
  "author": "Ján Zahurančík and contributors",
  "description": "Ready-to-use Amiga desktop with hundreds of tools and a modern look.",
  "intro": "AmiKit is a ready-to-use Amiga desktop with hundreds of tools and a modern look.",
  "website": "https://www.amikit.amiga.sk/store-pistorm",
  "licence": "Commercial licensed software with a one-user licence. MultibootOS never distributes it.",
  "licenceRequirement": "commercial",
  "order": 40,
  "colours": {"light": "#1F8A8A", "dark": "#3FB5B5"},
  "bootMenu": {"label": "AmiKit", "script": "AmiKit", "flag": "AmikitOS", "startsFrom": "AK0"},
  "hideCore": true,
  "versions": [
    // AmiKit 12.2 for PiStorm (the user's own licensed image). AK0 and AK1 each sit alone in MBR partitions 2 and 3.
    {
      "id": "amikit-12.2",
      "version": "12.2",
      // AmiKit boots +KickstartROM/kick.rom: the 3.1 A1200 ROM, or the 3.2 one when AmigaOS 3.2 is on the card too.
      "roms": [{"any": ["kick31-a1200", "kick32-a1200"]}],
      "geometry": {"heads": 6, "sectors": 256},
      "sources": [
        {"label": "AmiKit image", "hint": "Path to the image file", "recognisedAs": "AmiKit 12.2", "kind": "file"}
      ],
      "partitions": [
        {"device": "AK0", "volume": "AmiKit", "dosType": "PFS3", "from": {"mbr": 2, "partition": 1}, "size": 12.88, "smallest": 8.61, "shrinkOrder": 2, "bootable": true},
        {"device": "AK1", "volume": "AmiKit_Stuff", "dosType": "PFS3", "from": {"mbr": 3, "partition": 1}, "size": 12.88, "smallest": 8.61, "shrinkOrder": 1}
      ],
      "messages": [
        {
          "kind": "info",
          "text": "AmiKit is licensed software. Point MultibootOS to the AmiKit image you have bought and it takes it from there."
        }
      ]
    }
  ]
}
