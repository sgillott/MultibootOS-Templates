{
  // The MultibootOS core: the boot partition (ABS:) and the Online Updater, which always takes slot 12. "version" is the MultibootOS release the card carries.
  // Sizes are in GB. A partition taken from the source ("from") gets its exact size from the image at build time.
  // What is the same for every version is at the top; "versions" lists each release, newest first (PLAN.md 22.5, R3).
  "name": "MultibootOS",
  "description": "The MultibootOS boot partition and online updater.",
  "bootMenu": {"label": "-> MultibootOS Online Update <-", "flag": "bootupdate"},
  "versions": [
    // The MultibootOS boot partition (ABS:) and the Online Updater, which always takes slot 12.
    // For the core, "version" is the MultibootOS release that the image carries; it has its own updater.
    {
      "id": "core",
      "version": "2.3",
      "partitions": [
        {"device": "FAT32", "volume": "EMU68", "dosType": "FAT32", "size": 1.18, "fixed": true},
        {"device": "ADH0", "volume": "ABS", "dosType": "PDS3", "size": 0.11, "fixed": true, "bootable": true, "bootPriority": 2}
      ]
    }
  ]
}
