{
  // Kickstart 1.3 (PLAN.md 25.1): no partition of its own. Its script, Kickstart13, comes with the activation files and runs
  // ADH0:tudescript, which soft-kicks the 1.3 ROM from ADH0:Devs/Kickstarts/kick34005.A500 after config_kick13.txt booted the 3.1 ROM.
  "name": "Kickstart 1.3",
  "author": "Commodore",
  "description": "Restarts the Amiga with the Kickstart 1.3 ROM, for old games and demos.",
  "intro": "Kickstart 1.3 restarts your Amiga with the original A500 ROM, for software that needs it. It does not run under emulation.",
  "licence": "Kickstart ROMs are Commodore's: use your own. MultibootOS never distributes them.",
  "licenceRequirement": "free",
  "order": 60,
  "colours": {"light": "#B8860B", "dark": "#D9A521"},
  "selectedByDefault": true,
  "bootMenu": {"label": "Kickstart 1.3", "script": "Kickstart13", "flag": "kick13"},
  "versions": [
    {
      "id": "kickstart-1.3",
      "version": "1.3",
      // config_kick13.txt boots the 3.1 ROM (kick31.rom) first, then TUDE soft-kicks the 1.3 ROM.
      "roms": [
        {"any": ["kick13-a500"]},
        {"any": ["kick31-a1200"]}
      ],
      "messages": [
        {
          "kind": "info",
          "text": "You need your own Kickstart 1.3 (34.5) A500 ROM, and the Kickstart 3.1 A1200 ROM the Amiga starts from before switching to 1.3. Choose a ROM file, or a folder of ROMs: the ROMs are recognised by their checksum and are asked for only once."
        }
      ]
    }
  ]
}
